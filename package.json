{
	"name": "obsidian-markdown-annotations",
	"version": "0.2.0",
	"description": "View, create, and edit Markdown Annotations for authorship tracking compatible with iA Writer",
	"main": "main.js",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"version": "node version-bump.mjs && git add manifest.json versions.json"
	},
	"keywords": [
		"markdown",
		"annotations",
		"authorship",
		"ia-writer"
	],
	"author": "",
	"license": "MIT",
	"devDependencies": {
		"@types/node": "^20.19.43",
		"@typescript-eslint/eslint-plugin": "^8.71.2",
		"@typescript-eslint/parser": "^8.71.2",
		"builtin-modules": "3.3.0",
		"esbuild": "^0.24.2",
		"obsidian": "^1.14.4",
		"tslib": "^2.8.1",
		"typescript": "^5.9.3"
	},
	"dependencies": {
		"graphemer": "^1.4.0"
	},
	"allowScripts": {
		"esbuild@0.24.2": true
	}
}
